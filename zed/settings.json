// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "diff_view_style": "unified",
  "disable_ai": true,
  "show_signature_help_after_edits": true,
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "git_panel": {
    "dock": "left"
  },
  "auto_update_extensions": {
    "odin": false
  },
  "buffer_font_family": ".ZedMono",
  "agent": {
    "dock": "right",
    "default_model": {
      "provider": "copilot_chat",
      "model": "gpt-4o"
    }
  },
  "title_bar": {
    // "show_menus": true,
  },
  "telemetry": {
    "metrics": false
  },
  "vim_mode": true,
  "vim": {
    "use_system_clipboard": "never"
  },
  "ui_font_size": 15,
  "buffer_font_size": 13,
  "format_on_save": "off",
  "remove_trailing_whitespace_on_save": false,
  "ensure_final_newline_on_save": false,
  "auto_signature_help": true,
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Fleet Dark"
  },
  "diagnostics": {
    "inline": {
      "enabled": true
    }
  },
  "search": {
    "include_ignored": true,
  },
  "semantic_tokens": "combined",
  "minimap": {
    "show": "auto",
    "display_in": "all_editors"
  },
  "languages": {
    "Shell Script": { "tab_size": 2 },
    "Lua": { "tab_size": 2 },
    "Python": {
      "language_servers": [
        // basedpyright consumes gigs of memory on a simple micropython project, at least on zed 0.225.9
        "!basedpyright",
        "ty",
        "pyright",
      ]
    }
  },
  "file_types": {
    "CMake": ["CMakeLists.txt", "cmake"]
  },
  // extension names can be found in ~/.local/share/zed/extensions/installed
  "auto_install_extensions": {
    "comment": true,
    "fleet-themes": true,
    "html": true,
    "neocmake": true,
    "odin": true,
    "proto": true,
    "gleam": true,
    "erlang": true,
    "lua": true,
    "toml": true
  }
}
